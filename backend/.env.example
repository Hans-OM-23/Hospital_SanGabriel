# Orígenes permitidos para el frontend Angular (separados por comas).
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# SQL Server con autenticación SQL (usuario y contraseña). Copiar este archivo
# a `.env` y completar los valores en el equipo local. `.env` no se versiona.
# DB_SERVER admite "localhost", "localhost\SQLEXPRESS" o "host,1433": si se
# necesita TCP, el puerto forma parte de DB_SERVER, nunca una variable aparte.
DB_SERVER=localhost
# Nombre previsto para la base definitiva. No se asume que exista todavía:
# para la primera comprobación de conexión puede usarse DB_NAME=master.
DB_NAME=HospitalSanGabriel
DB_USER=usuario_sql
DB_PASSWORD=cambia_esta_clave
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes
