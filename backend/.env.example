# Orígenes permitidos para el frontend Angular (separados por comas).
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# SQL Server con autenticación SQL (usuario y contraseña). Copiar este archivo
# a `.env` y completar los valores en el equipo local. `.env` no se versiona.
# DB_SERVER admite "localhost", "localhost\SQLEXPRESS" o "host,1433": si se
# necesita TCP, el puerto forma parte de DB_SERVER, nunca una variable aparte.
DB_SERVER=localhost
# Base real de inventario instalada con los scripts de backend/db/.
DB_NAME=HospitalSanGabriel
DB_USER=usuario_sql
DB_PASSWORD=cambia_esta_clave
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# --- Seguridad de los tokens (etapa 6) ---
# Clave de firma HS256. Mínimo 32 caracteres. Genera una propia y no reutilices
# una clave pública de ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si falta o es insegura, la API se niega a emitir tokens de acceso.
JWT_SECRET_KEY=
# Vigencia del token en minutos (entre 1 y 10080).
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
